# ---------------------------------------------------------------------------
# CampusCycle backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5175

# --- PostgreSQL connection -------------------------------------------------
# Option A (preferred): a single connection string.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/campuscycle

# Option B: individual variables (used only if DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuscycle
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Auth ------------------------------------------------------------------
# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-12 is a good balance for development)
BCRYPT_ROUNDS=10
